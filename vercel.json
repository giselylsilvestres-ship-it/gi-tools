{
  "rewrites": [
    { "source": "/gica-icon-black-cream-v2.png", "destination": "/apple-touch-icon-precomposed.png" },
    { "source": "/gica-icon-black-cream-v1.png", "destination": "/apple-touch-icon-precomposed.png" },
    { "source": "/apple-touch-icon.png", "destination": "/apple-touch-icon-precomposed.png" },
    { "source": "/apple-touch-icon-v3.png", "destination": "/apple-touch-icon-precomposed.png" },
    { "source": "/apple-touch-icon-gica-20261026.png", "destination": "/apple-touch-icon-precomposed.png" },
    { "source": "/icon-512.png", "destination": "/apple-touch-icon-precomposed.png" },
    { "source": "/api/apple-touch-icon-v4.png", "destination": "/apple-touch-icon-precomposed.png" }
  ],
  "headers": [
    {"source":"/gica-icon-black-cream-v2.png","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/manifest-black-cream-v2.webmanifest","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}
  ],
  "crons": [
    {
      "path": "/api/garmin-sync",
      "schedule": "0 4 * * *"
    }
  ]
}
